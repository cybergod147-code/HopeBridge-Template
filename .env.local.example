# Required to bootstrap the first protected /admin account.
# Copy this file to .env.local and replace the values before running the app.
HOPEBRIDGE_ADMIN_USERNAME=admin
HOPEBRIDGE_ADMIN_PASSWORD=replace-with-a-strong-password-12-chars-minimum
HOPEBRIDGE_ADMIN_SECRET=replace-with-a-long-random-session-secret

# Optional payment integration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_configure_me
